{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "~/*": ["app/*"],
      "~": ["app"],
      "@/*": ["app/*"],
      "@": ["app"]
    },
    "types": ["node"]
  },
  "include": ["./**/*", "../app/**/*"]
}
