{
  "name": "Custom menu config for BLU000000000290",
  "type": "CUSTOM_REFERENCED",
  "description": "Custom menu config with reference prompt",
  "menuConfig": {
    "entry": "enter_giving",
    "steps": [
      {
        "id": "enter_giving",
        "type": "MENU",
        "prompt": "Welcome to {{merchantName}}\n1. Offering\n2. Tithes\n3. Seed\n4.Thanksgiving\n5. Pledges",
        "options": [
          {
            "set": {
              "givingType": "Offering"
            },
            "next": "enter_name",
            "input": "1",
            "value": "Offering"
          },
          {
            "set": {
              "givingType": "Tithes"
            },
            "next": "enter_name",
            "input": "2",
            "value": "Tithes"
          },
          {
            "set": {
              "givingType": "Seed"
            },
            "next": "enter_name",
            "input": "3",
            "value": "Seed"
          },
          {
            "set": {
              "givingType": "Thanksgiving"
            },
            "next": "enter_name",
            "input": "4",
            "value": "Thanksgiving"
          },
          {
            "set": {
              "givingType": "Pledges"
            },
            "next": "enter_name",
            "input": "5",
            "value": "Pledges"
          }
        ]
      },
      {
        "id": "enter_name",
        "next": "enter_amount",
        "type": "INPUT",
        "input": {
          "variable": "name"
        },
        "prompt": "Enter name:"
      },
      {
        "id": "enter_amount",
        "next": "enter_description",
        "type": "INPUT",
        "input": {
          "variable": "amount",
          "validation": {
            "type": "AMOUNT",
            "minValue": 0.01,
            "errorMessage": "Invalid amount. Enter numbers only"
          }
        },
        "prompt": "Enter amount:"
      },
      {
        "id": "enter_description",
        "next": "process_payment",
        "type": "INPUT",
        "input": {
          "variable": "description",
          "validation": {
            "type": "ALPHANUMERIC"
          }
        },
        "prompt": "Enter reference:"
      },
      {
        "id": "process_payment",
        "type": "ACTION",
        "onFailure": "payment_failed",
        "onSuccess": "payment_success",
        "actionName": "processPaymentToMerchant"
      },
      {
        "id": "payment_success",
        "type": "END",
        "prompt": "Request submitted successfully. You will receive a payment prompt shortly. If prompt delays, dial *170# to approve transaction. Ref: {{transactionReference}}."
      },
      {
        "id": "payment_failed",
        "type": "END",
        "prompt": "Transfer failed. Please try again later."
      }
    ],
    "version": 1,
    "configId": "config_v1",
    "metadata": {
      "name": "MENU CONFIG",
      "description": "BLU PAY USSD MENU FLOW",
      "merchantCode": "BLU000000000290"
    }
  }
}